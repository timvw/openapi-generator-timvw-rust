/// A file of a `multipart/form-data` request: its bytes, with the file name and media type the client gave.
#[derive(Clone, Debug, Default, PartialEq)]
pub struct FilePart {
    /// The part's file name (`filename` of its `Content-Disposition`), when it has one.
    pub file_name: Option<String>,
    /// The part's `Content-Type`, when it has one.
    pub content_type: Option<String>,
    /// The file.
    pub bytes: axum::body::Bytes,
}

/// One part of a `multipart/form-data` request, or one pair of an `application/x-www-form-urlencoded` one.
struct FormPart {
    name: String,
    file_name: Option<String>,
    content_type: Option<String>,
    bytes: axum::body::Bytes,
}

impl FormPart {
    fn file(&self) -> FilePart {
        FilePart {
            file_name: self.file_name.clone(),
            content_type: self.content_type.clone(),
            bytes: self.bytes.clone(),
        }
    }

    fn text(&self) -> Result<&str, RequestError> {
        std::str::from_utf8(&self.bytes).map_err(|_| RequestError::new("body", Some(&self.name), "not UTF-8"))
    }
}

/// The pairs of an `application/x-www-form-urlencoded` body, as parts.
#[allow(dead_code)]
fn form_pairs(body: &[u8]) -> Vec<FormPart> {
    url::form_urlencoded::parse(body)
        .map(|(name, value)| FormPart {
            name: name.into_owned(),
            file_name: None,
            content_type: None,
            bytes: axum::body::Bytes::from(value.into_owned()),
        })
        .collect()
}

/// The pairs of an `application/x-www-form-urlencoded` body, or `None` for an empty one.
#[allow(dead_code)]
fn optional_form_pairs(body: &[u8]) -> Option<Vec<FormPart>> {
    (!body.is_empty()).then(|| form_pairs(body))
}
{{#serverMultipart}}

/// The parts of a `multipart/form-data` request.
#[allow(dead_code)]
async fn multipart_parts(request: axum::extract::Request) -> Result<Vec<FormPart>, RequestError> {
    use axum::extract::FromRequest;

    let mut multipart = axum::extract::Multipart::from_request(request, &())
        .await
        .map_err(|rejection| RequestError::new("body", None, rejection.body_text()))?;
    let mut parts = Vec::new();
    loop {
        let field = match multipart.next_field().await {
            Ok(Some(field)) => field,
            Ok(None) => return Ok(parts),
            Err(error) => return Err(RequestError::new("body", None, error.body_text())),
        };
        let name = field.name().unwrap_or_default().to_owned();
        let file_name = field.file_name().map(str::to_owned);
        let content_type = field.content_type().map(str::to_owned);
        let bytes = field.bytes().await.map_err(|error| RequestError::new("body", Some(&name), error.body_text()))?;
        parts.push(FormPart { name, file_name, content_type, bytes });
