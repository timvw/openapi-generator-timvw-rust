{{>partial_header}}
//! The server, on axum: one trait per API module, with a method per operation the server serves, a request struct
//! and a response enum per operation, and [`router`], which serves an implementation of every trait.
//!
//! ```ignore
//! #[derive(Clone)]
//! struct MyApi;
//!
//! impl server::ErrorHandler for MyApi {}
//! // impl server::<module>::<Trait> for MyApi { ... }
//!
//! let app: axum::Router = server::router(MyApi);
//! ```
//!
//! A request whose path or query parameters or body do not decode is answered by
//! [`ErrorHandler::invalid_request`] (a `400` with a JSON error body by default, a `415` for a body of a media type
//! the operation does not take) without calling the implementation; an implementation's error by
//! [`ErrorHandler::server_error`] (a `500`).
//!
//! A request body is its model for JSON, a `String` for text, the bytes for anything else, and a form struct for
//! `multipart/form-data` (with a `FilePart` per file) and `application/x-www-form-urlencoded`. A body the spec gives
//! more than one kind of media type is an enum with a variant per kind, chosen by the request's `Content-Type`. A
//! response is its model for JSON, an `EventStream` of the
//! event type for `text/event-stream`, a `String` for text and a `Binary` for anything else. Bodies are read whole,
//! within axum's limit (2 MB by default; raise it with the router's `axum::extract::DefaultBodyLimit` layer).

{{#serverModules}}
pub use self::{{{module}}}::{{{trait}}};
{{/serverModules}}

/// An error of an implementation of the server's traits: the server answers it with
/// [`ErrorHandler::server_error`]. Any error converts into it with `?`, and [`ServerError::new`] makes one from a
/// message.
#[derive(Debug)]
pub struct ServerError(Box<dyn std::error::Error + Send + Sync>);

impl ServerError {
    /// An error with this message.
    pub fn new(message: impl Into<String>) -> Self {
        ServerError(message.into().into())
    }

    /// The error of an operation the implementation does not implement: the server answers it with a `501`.
    pub fn not_implemented(operation: &'static str) -> Self {
        ServerError(Box::new(NotImplemented(operation)))
    }

    /// The operation, if this is the error of one the implementation does not implement
    /// ([`not_implemented`](Self::not_implemented)).
    pub fn not_implemented_operation(&self) -> Option<&'static str> {
        self.0.downcast_ref::<NotImplemented>().map(|n| n.0)
    }

    /// The error it holds.
    pub fn inner(&self) -> &(dyn std::error::Error + Send + Sync + 'static) {
        &*self.0
    }
}

/// The error of an operation the implementation does not implement.
#[derive(Debug)]
struct NotImplemented(&'static str);

impl std::fmt::Display for NotImplemented {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} is not implemented", self.0)
    }
}

impl std::error::Error for NotImplemented {}

impl std::fmt::Display for ServerError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

impl<E: std::error::Error + Send + Sync + 'static> From<E> for ServerError {
    fn from(error: E) -> Self {
        ServerError(Box::new(error))
    }
}

/// A request the server cannot decode: a path or query parameter that is missing or does not parse as its type, a
/// body that is not the JSON of its type, or a body of a media type the operation does not take.
#[derive(Clone, Debug, PartialEq)]
pub struct RequestError {
    status: http::StatusCode,
    location: &'static str,
    name: Option<String>,
    message: String,
}

impl RequestError {
    /// An error of the request's `location` (`path`, `query` or `body`), at the parameter `name` if any: a `400`.
    pub fn new(location: &'static str, name: Option<&str>, message: impl Into<String>) -> Self {
        RequestError {
            status: http::StatusCode::BAD_REQUEST,
            location,
            name: name.map(str::to_owned),
            message: message.into(),
        }
    }

    /// A body of a media type the operation does not take (`None`: the request has no `Content-Type`): a `415`.
    pub fn unsupported_media_type(media_type: Option<&str>) -> Self {
        let message = match media_type {
            Some(media_type) => format!("the media type '{media_type}' is not one the operation takes"),
            None => "the request has no Content-Type".to_owned(),
        };
        RequestError::new("body", None, message).with_status(http::StatusCode::UNSUPPORTED_MEDIA_TYPE)
    }

    /// The same error, answered with this status.
    pub fn with_status(mut self, status: http::StatusCode) -> Self {
        self.status = status;
        self
    }

    /// The status the default [`ErrorHandler::invalid_request`] answers with: `400`, `415` for a media type the
    /// operation does not take, `413` for a body over the limit.
    pub fn status(&self) -> http::StatusCode {
        self.status
    }

    /// Where in the request: `path`, `query` or `body`.
    pub fn location(&self) -> &'static str {
        self.location
    }

    /// The parameter, for a path or query parameter.
    pub fn name(&self) -> Option<&str> {
        self.name.as_deref()
    }

    /// What is wrong.
    pub fn message(&self) -> &str {
        &self.message
    }
}

impl std::fmt::Display for RequestError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match &self.name {
            Some(name) => write!(f, "{} parameter `{}`: {}", self.location, name, self.message),
            None => write!(f, "{}: {}", self.location, self.message),
        }
    }
}

impl std::error::Error for RequestError {}

/// How the server answers what the implementation does not: a request that does not decode, and an implementation's
/// error. Both methods have a default; implement the trait with `impl ErrorHandler for MyApi {}` to keep them.
pub trait ErrorHandler {
    /// The response to a request that does not decode. By default the error's [`status`](RequestError::status) (a
    /// `400`, or a `415` for a body of a media type the operation does not take) with the JSON body
    /// `{"error": {"message": "...", "location": "query", "name": "limit"}}` (`name` only for a parameter).
    fn invalid_request(&self, error: RequestError) -> axum::response::Response {
        let mut body = serde_json::Map::new();
        body.insert("message".to_owned(), serde_json::Value::String(error.to_string()));
        body.insert("location".to_owned(), serde_json::Value::String(error.location().to_owned()));
        if let Some(name) = error.name() {
            body.insert("name".to_owned(), serde_json::Value::String(name.to_owned()));
        }
        error_response(error.status(), body)
    }

    /// The response to an implementation's error. By default a `500` with the JSON body
    /// `{"error": {"message": "internal server error"}}`: the error is not shown to the caller. An operation the
    /// implementation does not implement ([`ServerError::not_implemented`]) is a `501`, with the body
    /// `{"error": {"message": "<operation> is not implemented"}}`.
    fn server_error(&self, error: ServerError) -> axum::response::Response {
        let mut body = serde_json::Map::new();
        if error.not_implemented_operation().is_some() {
            body.insert("message".to_owned(), serde_json::Value::String(error.to_string()));
            return error_response(http::StatusCode::NOT_IMPLEMENTED, body);
        }
        body.insert("message".to_owned(), serde_json::Value::String("internal server error".to_owned()));
        error_response(http::StatusCode::INTERNAL_SERVER_ERROR, body)
    }
}

/// Serves `api`, an implementation of every trait of the server, with its error handler: a route per operation.
pub fn router<I>(api: I) -> axum::Router
where
    I: {{#serverModules}}{{{module}}}::{{{trait}}} + {{/serverModules}}ErrorHandler + 'static,
{
    let router = axum::Router::new();
    {{#serverModules}}
    let router = {{{module}}}::routes::<I>(router);
    {{/serverModules}}
    router.with_state(std::sync::Arc::new(api))
}

fn error_response(status: http::StatusCode, error: serde_json::Map<String, serde_json::Value>) -> axum::response::Response {
    let mut body = serde_json::Map::new();
    body.insert("error".to_owned(), serde_json::Value::Object(error));
    json_response(status, http::HeaderMap::new(), &body)
}

/// `body` as JSON with this status and these headers; a body that does not serialize is a `500`.
#[allow(dead_code)]
fn json_response<T: serde::Serialize>(
    status: http::StatusCode,
    headers: http::HeaderMap,
    body: &T,
) -> axum::response::Response {
    let (status, bytes) = match serde_json::to_vec(body) {
        Ok(bytes) => (status, bytes),
        Err(_) => (
            http::StatusCode::INTERNAL_SERVER_ERROR,
            br#"{"error":{"message":"the response does not serialize"}}"#.to_vec(),
        ),
    };
    let mut response = axum::response::Response::new(axum::body::Body::from(bytes));
    *response.status_mut() = status;
    response.headers_mut().extend(headers);
    response.headers_mut().insert(http::header::CONTENT_TYPE, http::HeaderValue::from_static("application/json"));
    response
}

/// An empty body with this status and these headers.
#[allow(dead_code)]
fn empty_response(status: http::StatusCode, headers: http::HeaderMap) -> axum::response::Response {
    let mut response = axum::response::Response::new(axum::body::Body::empty());
    *response.status_mut() = status;
    response.headers_mut().extend(headers);
    response
}

#[allow(dead_code)]
fn status(code: u16) -> http::StatusCode {
    http::StatusCode::from_u16(code).unwrap_or(http::StatusCode::INTERNAL_SERVER_ERROR)
}

#[allow(dead_code)]
fn query_pairs(query: Option<&str>) -> Vec<(String, String)> {
    url::form_urlencoded::parse(query.unwrap_or("").as_bytes()).into_owned().collect()
}

/// The path parameter at `key` (its position in the route), `name` in the spec, read by `parse`.
#[allow(dead_code)]
fn path_value<T>(
    path: &std::collections::HashMap<String, String>,
    key: &str,
    name: &str,
    parse: impl Fn(&str) -> Option<T>,
) -> Result<T, RequestError> {
    let value = path.get(key).ok_or_else(|| RequestError::new("path", Some(name), "missing"))?;
    parse(value).ok_or_else(|| RequestError::new("path", Some(name), format!("invalid value '{value}'")))
}

/// The first value of the query parameter `name`, read by `parse`; `None` when the query does not have it.
#[allow(dead_code)]
fn query_value<T>(
    query: &[(String, String)],
    name: &str,
    parse: impl Fn(&str) -> Option<T>,
) -> Result<Option<T>, RequestError> {
    match query.iter().find(|(key, _)| key == name) {
        None => Ok(None),
        Some((_, value)) => parse(value)
            .map(Some)
            .ok_or_else(|| RequestError::new("query", Some(name), format!("invalid value '{value}'"))),
    }
}

/// The items of the query parameter `name`: one per occurrence, or the items of its one value split by
/// `separator`, each read by `parse`; `None` when the query does not have it.
#[allow(dead_code)]
fn query_list<T>(
    query: &[(String, String)],
    name: &str,
    separator: Option<&str>,
    parse: impl Fn(&str) -> Option<T>,
) -> Result<Option<Vec<T>>, RequestError> {
    let values: Vec<&str> = query.iter().filter(|(key, _)| key == name).map(|(_, value)| value.as_str()).collect();
    if values.is_empty() {
        return Ok(None);
    }
    let mut items = Vec::new();
    for value in values {
        let parts: Vec<&str> = match separator {
            Some(separator) if !value.is_empty() => value.split(separator).collect(),
            Some(_) => Vec::new(),
            None => vec![value],
        };
        for part in parts {
            items.push(parse(part).ok_or_else(|| {
                RequestError::new("query", Some(name), format!("invalid item '{part}'"))
            })?);
        }
    }
    Ok(Some(items))
}

/// A required parameter's value: an error when it is missing.
#[allow(dead_code)]
fn required<T>(location: &'static str, name: &str, value: Option<T>) -> Result<T, RequestError> {
    value.ok_or_else(|| RequestError::new(location, Some(name), "missing"))
}

#[allow(dead_code)]
fn json_body<T: serde::de::DeserializeOwned>(body: &[u8]) -> Result<T, RequestError> {
    if body.iter().all(u8::is_ascii_whitespace) {
        return Err(RequestError::new("body", None, "missing"));
    }
    serde_json::from_slice(body).map_err(|e| RequestError::new("body", None, e.to_string()))
}

#[allow(dead_code)]
fn optional_json_body<T: serde::de::DeserializeOwned>(body: &[u8]) -> Result<Option<T>, RequestError> {
    if body.iter().all(u8::is_ascii_whitespace) {
        return Ok(None);
    }
    // `null` is no body too: what a client sends for one it does not have
    serde_json::from_slice(body).map_err(|e| RequestError::new("body", None, e.to_string()))
}

#[allow(dead_code)]
fn text_body(body: &[u8]) -> Result<String, RequestError> {
    String::from_utf8(body.to_vec()).map_err(|_| RequestError::new("body", None, "not UTF-8"))
}

#[allow(dead_code)]
fn optional_text_body(body: &[u8]) -> Result<Option<String>, RequestError> {
    if body.is_empty() {
        return Ok(None);
    }
    text_body(body).map(Some)
}

#[allow(dead_code)]
fn optional_bytes(body: axum::body::Bytes) -> Option<axum::body::Bytes> {
    (!body.is_empty()).then_some(body)
}

/// `body` as text of this media type, with this status and these headers.
#[allow(dead_code)]
fn text_response(
    status: http::StatusCode,
    headers: http::HeaderMap,
    body: String,
    content_type: &'static str,
) -> axum::response::Response {
    let mut response = axum::response::Response::new(axum::body::Body::from(body));
    *response.status_mut() = status;
    response.headers_mut().extend(headers);
    response.headers_mut().insert(http::header::CONTENT_TYPE, http::HeaderValue::from_static(content_type));
    response
}
{{#serverStreams}}

/// A stream of server-sent events, each the JSON of a `T` in a `data:` line, as the client's typed event streams read
/// them; when the spec's event schema has a discriminator, an `event:` line names each event by it (as OpenAI names
/// a Responses stream's events by their `type`). [`EventStream::done`] ends the stream with `data: [DONE]`, for
/// clients that wait for it.
///
/// An error of the stream, or an event that does not serialize, ends the response abruptly: the client sees the body
/// fail, not a clean end.
pub struct EventStream<T> {
    events: std::pin::Pin<Box<dyn futures_util::Stream<Item = Result<T, ServerError>> + Send>>,
    done: bool,
}

impl<T: Send + 'static> EventStream<T> {
    /// The events of `stream`.
    pub fn new<S>(stream: S) -> Self
    where
        S: futures_util::Stream<Item = T> + Send + 'static,
    {
        Self::try_new(futures_util::StreamExt::map(stream, Ok))
    }

    /// The events of `stream`, which can fail: an error ends the response.
    pub fn try_new<S>(stream: S) -> Self
    where
        S: futures_util::Stream<Item = Result<T, ServerError>> + Send + 'static,
    {
        EventStream { events: Box::pin(stream), done: false }
    }

    /// The events of `events`, all known up front.
    pub fn from_events<I>(events: I) -> Self
    where
        I: IntoIterator<Item = T>,
        I::IntoIter: Send + 'static,
    {
        Self::new(futures_util::stream::iter(events))
    }

    /// Ends the stream with `data: [DONE]` after its events.
    pub fn done(mut self) -> Self {
        self.done = true;
        self
    }
}

impl<T> std::fmt::Debug for EventStream<T> {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("EventStream").field("done", &self.done).finish_non_exhaustive()
    }
}

/// A body that is not JSON or text: bytes held in memory or a stream of chunks, sent with the media type the spec
/// declares unless [`Binary::content_type`] sets another.
pub struct Binary {
    body: axum::body::Body,
    content_type: Option<http::HeaderValue>,
}

impl Binary {
    /// Bytes held in memory: the response has a `Content-Length`.
    pub fn bytes(bytes: impl Into<axum::body::Bytes>) -> Self {
        Binary { body: axum::body::Body::from(bytes.into()), content_type: None }
    }

    /// A stream of chunks, sent as they come (chunked). An error of the stream ends the response abruptly.
    pub fn stream<S, B, E>(stream: S) -> Self
    where
        S: futures_util::Stream<Item = Result<B, E>> + Send + 'static,
        B: Into<axum::body::Bytes> + 'static,
        E: Into<Box<dyn std::error::Error + Send + Sync>> + 'static,
    {
        Binary { body: axum::body::Body::from_stream(stream), content_type: None }
    }

    /// The media type of the body, instead of the one the spec declares (needed when it declares a range such as
    /// `audio/*`, or more than one). A value that is not a valid header value is ignored.
    pub fn content_type(mut self, content_type: &str) -> Self {
        self.content_type = http::HeaderValue::from_str(content_type).ok();
        self
    }
}

impl From<axum::body::Bytes> for Binary {
    fn from(bytes: axum::body::Bytes) -> Self {
        Binary::bytes(bytes)
    }
}

impl From<Vec<u8>> for Binary {
    fn from(bytes: Vec<u8>) -> Self {
        Binary::bytes(bytes)
    }
}

impl From<&'static [u8]> for Binary {
    fn from(bytes: &'static [u8]) -> Self {
        Binary::bytes(bytes)
    }
}

impl std::fmt::Debug for Binary {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Binary").field("content_type", &self.content_type).finish_non_exhaustive()
    }
}

/// The events of `body` as `text/event-stream`, with this status and these headers; each named by its `name`
/// property (an `event:` line) when there is one.
#[allow(dead_code)]
fn event_stream_response<T: serde::Serialize + Send + 'static>(
    status: http::StatusCode,
    headers: http::HeaderMap,
    body: EventStream<T>,
    name: Option<&'static str>,
) -> axum::response::Response {
    use futures_util::StreamExt;

    type BoxError = Box<dyn std::error::Error + Send + Sync>;
    let done = body.done;
    let events = body.events.map(move |event| -> Result<axum::body::Bytes, BoxError> {
        let event = event.map_err(|error| error.0)?;
        let mut line = Vec::new();
        if let Some(name) = name {
            // read from its JSON value, then written as it serializes (a value's object keys would be sorted)
            let value = serde_json::to_value(&event)?;
            let named = value.get(name).and_then(serde_json::Value::as_str);
            if let Some(named) = named.filter(|n| !n.contains(['\n', '\r'])) {
                line.extend_from_slice(b"event: ");
                line.extend_from_slice(named.as_bytes());
                line.push(b'\n');
            }
        }
        line.extend_from_slice(b"data: ");
        serde_json::to_writer(&mut line, &event)?;
        line.extend_from_slice(b"\n\n");
        Ok(line.into())
    });
    let end = futures_util::stream::iter(
        done.then(|| Ok::<_, BoxError>(axum::body::Bytes::from_static(b"data: [DONE]\n\n"))),
    );
    let mut response = axum::response::Response::new(axum::body::Body::from_stream(events.chain(end)));
    *response.status_mut() = status;
    response.headers_mut().extend(headers);
    response.headers_mut().insert(http::header::CONTENT_TYPE, http::HeaderValue::from_static("text/event-stream"));
    response.headers_mut().insert(http::header::CACHE_CONTROL, http::HeaderValue::from_static("no-cache"));
    response
}

/// `body` with this status and these headers, as its own media type or else `content_type`.
#[allow(dead_code)]
fn binary_response(
    status: http::StatusCode,
    headers: http::HeaderMap,
    body: Binary,
    content_type: &'static str,
) -> axum::response::Response {
    let mut response = axum::response::Response::new(body.body);
    *response.status_mut() = status;
    response.headers_mut().extend(headers);
    let content_type = body.content_type.unwrap_or_else(|| http::HeaderValue::from_static(content_type));
    response.headers_mut().insert(http::header::CONTENT_TYPE, content_type);
    response
}
