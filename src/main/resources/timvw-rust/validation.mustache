//! Checks a model against the validation keywords of its schema.
//!
//! Every model implements [`Validate`]. Nothing in this crate calls it: validating a request before sending it, or a
//! response after decoding it, is the caller's choice. `validate()` returns the first value that breaks a rule, with
//! the path to it in wire names (`messages[2].content`, `metadata["key"]`).
//!
//! What is checked: `minLength` and `maxLength` (in characters), `pattern`, `minimum`, `maximum`, `exclusiveMinimum`,
//! `exclusiveMaximum`, `multipleOf`, `minItems`, `maxItems`, `uniqueItems` (by equality), `minProperties` and
//! `maxProperties` of maps, in every nested model, list, map and union variant. A `pattern` is matched with the
//! [`regex`](https://docs.rs/regex) crate, whose classes such as `\d` and `\w` are Unicode-aware; a pattern it cannot
//! compile is not checked.

use std::fmt;

/// A model that can check itself against the validation keywords of its schema.
pub trait Validate {
    /// The first value that breaks a validation keyword of the schema, if any.
    fn validate(&self) -> Result<(), ValidationError>;
}

/// A validation keyword of the schema, with the limit it sets.
#[derive(Clone, Debug, PartialEq)]
#[non_exhaustive]
pub enum Rule {
    /// `minLength`: the least number of characters.
    MinLength(u64),
    /// `maxLength`: the greatest number of characters.
    MaxLength(u64),
    /// `pattern`: a regular expression the string must contain a match of.
    Pattern(&'static str),
    /// `minimum`
    Minimum(f64),
    /// `exclusiveMinimum`
    ExclusiveMinimum(f64),
    /// `maximum`
    Maximum(f64),
    /// `exclusiveMaximum`
    ExclusiveMaximum(f64),
    /// `multipleOf`
    MultipleOf(f64),
    /// `minItems`
    MinItems(u64),
    /// `maxItems`
    MaxItems(u64),
    /// `uniqueItems`: no two items are equal.
    UniqueItems,
    /// `minProperties` of a map.
    MinProperties(u64),
    /// `maxProperties` of a map.
    MaxProperties(u64),
}

impl fmt::Display for Rule {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Rule::MinLength(n) => write!(f, "minLength {n}"),
            Rule::MaxLength(n) => write!(f, "maxLength {n}"),
            Rule::Pattern(p) => write!(f, "pattern {p:?}"),
            Rule::Minimum(n) => write!(f, "minimum {n}"),
            Rule::ExclusiveMinimum(n) => write!(f, "exclusiveMinimum {n}"),
            Rule::Maximum(n) => write!(f, "maximum {n}"),
            Rule::ExclusiveMaximum(n) => write!(f, "exclusiveMaximum {n}"),
            Rule::MultipleOf(n) => write!(f, "multipleOf {n}"),
            Rule::MinItems(n) => write!(f, "minItems {n}"),
            Rule::MaxItems(n) => write!(f, "maxItems {n}"),
            Rule::UniqueItems => write!(f, "uniqueItems"),
            Rule::MinProperties(n) => write!(f, "minProperties {n}"),
            Rule::MaxProperties(n) => write!(f, "maxProperties {n}"),
        }
    }
}

/// A value that breaks a validation keyword of its schema.
#[derive(Clone, Debug, PartialEq)]
pub struct ValidationError {
    /// Where the value is, in wire names: `messages[2].content`, `metadata["key"]`; empty for the value itself.
    pub path: String,
    /// The keyword it breaks.
    pub rule: Rule,
    /// What breaks it: the value (a number, or a string for `pattern`), its size (`length 0`, `3 items`,
    /// `0 properties`), or the equal items for `uniqueItems`.
    pub actual: String,
}

impl ValidationError {
    /// An error about the value itself; the callers add the path.
    pub fn new(rule: Rule, actual: impl Into<String>) -> Self {
        ValidationError { path: String::new(), rule, actual: actual.into() }
    }

    /// The same error, seen from the object that holds the value in `field`.
    pub fn at(self, field: &str) -> Self {
        self.prefixed(field.to_string())
    }

    /// The same error, seen from the list that holds the value at `index`.
    pub fn at_index(self, index: usize) -> Self {
        self.prefixed(format!("[{index}]"))
    }

    /// The same error, seen from the map that holds the value under `key`.
    pub fn at_key(self, key: &str) -> Self {
        self.prefixed(format!("[{key:?}]"))
    }

    fn prefixed(mut self, segment: String) -> Self {
        self.path = if self.path.is_empty() {
            segment
        } else if self.path.starts_with('[') {
            segment + &self.path
        } else {
            segment + "." + &self.path
        };
        self
    }
}

impl fmt::Display for ValidationError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        if self.path.is_empty() {
            write!(f, "{} breaks {}", self.actual, self.rule)
        } else {
            write!(f, "{}: {} breaks {}", self.path, self.actual, self.rule)
        }
    }
}

impl std::error::Error for ValidationError {}

impl<T: Validate + ?Sized> Validate for Box<T> {
    fn validate(&self) -> Result<(), ValidationError> {
        (**self).validate()
    }
}

impl<T: Validate> Validate for Option<T> {
    fn validate(&self) -> Result<(), ValidationError> {
        match self {
            Some(value) => value.validate(),
            None => Ok(()),
        }
    }
}

impl<T: Validate> Validate for Vec<T> {
    fn validate(&self) -> Result<(), ValidationError> {
        for (index, item) in self.iter().enumerate() {
            item.validate().map_err(|e| e.at_index(index))?;
        }
        Ok(())
    }
}

impl<T: Validate, S> Validate for std::collections::HashMap<String, T, S> {
    fn validate(&self) -> Result<(), ValidationError> {
        for (key, value) in self {
            value.validate().map_err(|e| e.at_key(key))?;
        }
        Ok(())
    }
}

/// A number type a bound can apply to.
pub trait Number: Copy + PartialOrd + fmt::Display {
    /// The value as `f64`, to report a limit.
    fn as_f64(self) -> f64;
    /// Whether the value is a multiple of `factor`; for floating point numbers, within a relative tolerance.
    fn is_multiple(self, factor: Self) -> bool;
}

macro_rules! integer {
    ($($t:ty),*) => {$(
        impl Number for $t {
            fn as_f64(self) -> f64 {
                self as f64
            }
            fn is_multiple(self, factor: Self) -> bool {
                self.checked_rem(factor).is_none_or(|rest| rest == 0)
            }
        }
    )*};
}

integer!(i8, i16, i32, i64, u8, u16, u32, u64);

macro_rules! float {
    ($($t:ty => $tolerance:expr),*) => {$(
        impl Number for $t {
            fn as_f64(self) -> f64 {
                f64::from(self)
            }
            fn is_multiple(self, factor: Self) -> bool {
                let quotient = self / factor;
                (quotient - quotient.round()).abs() <= $tolerance * quotient.abs().max(1.0)
            }
        }
    )*};
}

float!(f32 => 1e-5, f64 => 1e-9);

/// `minLength` and `maxLength`, in characters.
pub fn length(value: &str, min: Option<u64>, max: Option<u64>) -> Result<(), ValidationError> {
    let length = value.chars().count() as u64;
    if let Some(min) = min.filter(|min| length < *min) {
        return Err(ValidationError::new(Rule::MinLength(min), format!("length {length}")));
    }
    if let Some(max) = max.filter(|max| length > *max) {
        return Err(ValidationError::new(Rule::MaxLength(max), format!("length {length}")));
    }
    Ok(())
}
{{#validationRegex}}

/// `pattern`: the string contains a match. A pattern `regex` could not compile is `None` and not checked.
pub fn pattern(
    value: &str,
    regex: &std::sync::LazyLock<Option<regex::Regex>>,
    source: &'static str,
) -> Result<(), ValidationError> {
    match &**regex {
        Some(regex) if !regex.is_match(value) => Err(ValidationError::new(Rule::Pattern(source), format!("{value:?}"))),
        _ => Ok(()),
    }
}
{{/validationRegex}}

/// `minimum`
pub fn minimum<T: Number>(value: T, bound: T) -> Result<(), ValidationError> {
    if value < bound {
        return Err(ValidationError::new(Rule::Minimum(bound.as_f64()), value.to_string()));
    }
    Ok(())
}

/// `exclusiveMinimum`
pub fn exclusive_minimum<T: Number>(value: T, bound: T) -> Result<(), ValidationError> {
    if value <= bound {
        return Err(ValidationError::new(Rule::ExclusiveMinimum(bound.as_f64()), value.to_string()));
    }
    Ok(())
}

/// `maximum`
pub fn maximum<T: Number>(value: T, bound: T) -> Result<(), ValidationError> {
    if value > bound {
        return Err(ValidationError::new(Rule::Maximum(bound.as_f64()), value.to_string()));
    }
    Ok(())
}

/// `exclusiveMaximum`
pub fn exclusive_maximum<T: Number>(value: T, bound: T) -> Result<(), ValidationError> {
    if value >= bound {
        return Err(ValidationError::new(Rule::ExclusiveMaximum(bound.as_f64()), value.to_string()));
    }
    Ok(())
}

/// `multipleOf`
pub fn multiple_of<T: Number>(value: T, factor: T) -> Result<(), ValidationError> {
    if !value.is_multiple(factor) {
        return Err(ValidationError::new(Rule::MultipleOf(factor.as_f64()), value.to_string()));
    }
    Ok(())
}

/// `minItems` and `maxItems`.
pub fn items(count: usize, min: Option<u64>, max: Option<u64>) -> Result<(), ValidationError> {
    let count = count as u64;
    if let Some(min) = min.filter(|min| count < *min) {
        return Err(ValidationError::new(Rule::MinItems(min), format!("{count} items")));
    }
    if let Some(max) = max.filter(|max| count > *max) {
        return Err(ValidationError::new(Rule::MaxItems(max), format!("{count} items")));
    }
    Ok(())
}

/// `uniqueItems`: no two items are equal.
pub fn unique_items<T: PartialEq>(items: &[T]) -> Result<(), ValidationError> {
    for (index, item) in items.iter().enumerate() {
        if let Some(first) = items[..index].iter().position(|earlier| earlier == item) {
            return Err(ValidationError::new(Rule::UniqueItems, format!("items {first} and {index} are equal")));
        }
    }
    Ok(())
}

/// `minProperties` and `maxProperties` of a map.
pub fn properties(count: usize, min: Option<u64>, max: Option<u64>) -> Result<(), ValidationError> {
    let count = count as u64;
    if let Some(min) = min.filter(|min| count < *min) {
        return Err(ValidationError::new(Rule::MinProperties(min), format!("{count} properties")));
    }
    if let Some(max) = max.filter(|max| count > *max) {
        return Err(ValidationError::new(Rule::MaxProperties(max), format!("{count} properties")));
    }
    Ok(())
}
