/// The request's media type (`Content-Type` without its parameters, in lower case), if it has one.
#[allow(dead_code)]
fn media_type(headers: &http::HeaderMap) -> Option<String> {
    let value = headers.get(http::header::CONTENT_TYPE)?.to_str().ok()?;
    let essence = value.split(';').next().unwrap_or_default().trim().to_ascii_lowercase();
    (!essence.is_empty()).then_some(essence)
}

/// Whether the media type `actual` is one of `declared`: the same, in the range a declared `type/*` or `*/*` covers,
/// or JSON when a declared one is.
#[allow(dead_code)]
fn media_matches(actual: &str, declared: &[&str]) -> bool {
    let json = |m: &str| m.starts_with("application/") && m.contains("json");
    declared.iter().any(|d| {
        *d == actual
            || *d == "*/*"
            || d.strip_suffix("/*").is_some_and(|t| actual.split('/').next() == Some(t))
            || (json(d) && json(actual))
    })
}

/// The whole body of `request`, within axum's limit.
#[allow(dead_code)]
async fn request_bytes(request: axum::extract::Request) -> Result<axum::body::Bytes, RequestError> {
    use axum::extract::FromRequest;

    axum::body::Bytes::from_request(request, &())
        .await
        .map_err(|rejection| RequestError::new("body", None, rejection.body_text()).with_status(rejection.status()))
}
