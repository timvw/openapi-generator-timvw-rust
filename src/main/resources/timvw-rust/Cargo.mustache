[package]
name = "{{{packageName}}}"
version = "{{#lambdaVersion}}{{{packageVersion}}}{{/lambdaVersion}}"
{{#infoEmail}}
authors = ["{{{.}}}"]
{{/infoEmail}}
{{^infoEmail}}
authors = ["OpenAPI Generator team and contributors"]
{{/infoEmail}}
{{#appDescription}}
description = "{{{.}}}"
{{/appDescription}}
{{#licenseInfo}}
license = "{{.}}"
{{/licenseInfo}}
{{^licenseInfo}}
# Override this license by providing a License Object in the OpenAPI.
license = "Unlicense"
{{/licenseInfo}}
edition = "2021"
# timvw-rust-runtime's minimum supported Rust version. To build on it, resolve dependency versions that support it:
# CARGO_RESOLVER_INCOMPATIBLE_RUST_VERSIONS=fallback cargo update (or resolver = "3" in your workspace).
rust-version = "{{{rustVersion}}}"
{{#publishRustRegistry}}
publish = ["{{.}}"]
{{/publishRustRegistry}}
{{#repositoryUrl}}
repository = "{{.}}"
{{/repositoryUrl}}
{{#documentationUrl}}
documentation = "{{.}}"
{{/documentationUrl}}
{{#homePageUrl}}
homepage = "{{.}}"
{{/homePageUrl}}

[dependencies]
{{#modelsCrate}}
# The models: {{{modelsCrate}}}'s, generated from the same spec with the same model options.
{{{modelsCrate}}} = { {{#modelsCrateVersion}}version = "{{{.}}}"{{/modelsCrateVersion}}{{#modelsCrateVersion}}{{#modelsCratePath}}, {{/modelsCratePath}}{{/modelsCrateVersion}}{{#modelsCratePath}}path = "{{{.}}}"{{/modelsCratePath}}{{#apiFeatures}}, {{/apiFeatures}}{{#apiFeatures}}default-features = false{{/apiFeatures}} }
{{/modelsCrate}}
{{^modelsCrate}}
{{#bonBuilders}}
{{^bonOptional}}
bon = "^3"
{{/bonOptional}}
{{#bonOptional}}
bon = { version = "^3", optional = true }
{{/bonOptional}}
{{/bonBuilders}}
{{/modelsCrate}}
serde = { version = "^1.0", features = ["derive"] }
{{^modelsCrate}}
{{#serdeWith}}
serde_with = { version = "^3.8", default-features = false, features = ["base64", "std", "macros"]{{#serdeWithOptional}}, optional = true{{/serdeWithOptional}} }
{{/serdeWith}}
{{/modelsCrate}}
serde_json = "^1.0"
{{#typedEventStreams}}
{{^targetFeatures}}
futures-core = "^0.3"
{{/targetFeatures}}
{{#targetFeatures}}
futures-core = { version = "^0.3", optional = true }
{{/targetFeatures}}
{{/typedEventStreams}}
{{^modelsCrate}}
serde_repr = "^0.1"
{{/modelsCrate}}
{{#useSerdePathToError}}
serde_path_to_error = "^0.1"
{{/useSerdePathToError}}
url = "^2.5"
{{^modelsCrate}}
{{#validationRegex}}
regex = "^1.10"
{{/validationRegex}}
{{/modelsCrate}}
{{#serverRegex}}
regex = { version = "^1.10"{{#targetFeatures}}, optional = true{{/targetFeatures}} }
{{/serverRegex}}
{{#hasUUIDs}}
uuid = { version = "^1.8", features = ["serde", "v4"]{{#uuidOptional}}, optional = true{{/uuidOptional}} }
{{/hasUUIDs}}
{{#dateTimeChrono}}
chrono = { version = "^0.4",  features = ["serde"]{{#dateTypesOptional}}, optional = true{{/dateTypesOptional}} }
{{/dateTimeChrono}}
{{#dateTimeJiff}}
jiff = { version = "^1", default-features = false, features = ["std", "serde"]{{#dateTypesOptional}}, optional = true{{/dateTypesOptional}} }
{{/dateTimeJiff}}
{{#runtimeDependency}}
timvw-rust-runtime = { version = "^{{{runtimeVersion}}}", default-features = false{{#runtimeFeatures}}, features = [{{{runtimeFeatures}}}]{{/runtimeFeatures}}{{#runtimePath}}, path = "{{{.}}}"{{/runtimePath}}{{#runtimeOptional}}, optional = true{{/runtimeOptional}} }
{{/runtimeDependency}}
{{#serverTarget}}
axum = { version = "^0.8", default-features = false{{#serverMultipart}}, features = ["multipart"]{{/serverMultipart}}{{#targetFeatures}}, optional = true{{/targetFeatures}} }
{{#serverStreams}}
futures-util = { version = "^0.3", default-features = false, features = ["std"]{{#targetFeatures}}, optional = true{{/targetFeatures}} }
{{/serverStreams}}
http = { version = "^1"{{#targetFeatures}}, optional = true{{/targetFeatures}} }
{{/serverTarget}}
{{#hasUUIDs}}

# WebAssembly in a JavaScript host (wasm32-unknown-unknown): uuid's `v4` draws from `crypto.getRandomValues`.
[target.'cfg(all(target_family = "wasm", target_os = "unknown"))'.dependencies]
uuid = { version = "^1.8", features = ["js"]{{#uuidOptional}}, optional = true{{/uuidOptional}} }
{{/hasUUIDs}}

[features]
{{#clientTarget}}
default = [{{#reqwestDefaultFeatures}}"{{.}}", {{/reqwestDefaultFeatures}}"retry"{{#apiFeatures}}, "full"{{/apiFeatures}}{{#targetFeatures}}, "client", "server"{{/targetFeatures}}]
native-tls = ["timvw-rust-runtime{{#runtimeOptional}}?{{/runtimeOptional}}/native-tls"]
rustls = ["timvw-rust-runtime{{#runtimeOptional}}?{{/runtimeOptional}}/rustls"]
retry = ["timvw-rust-runtime{{#runtimeOptional}}?{{/runtimeOptional}}/retry"]
tracing = ["timvw-rust-runtime{{#runtimeOptional}}?{{/runtimeOptional}}/tracing"]
{{/clientTarget}}
{{^clientTarget}}
default = [{{#apiFeatures}}"full"{{/apiFeatures}}]
{{/clientTarget}}
{{#targetFeatures}}
# Targets: `client` compiles the HTTP client (`apis`), `server` the axum server (`server`).
client = [{{#runtimeOptional}}"dep:timvw-rust-runtime", {{/runtimeOptional}}"dep:http"{{#typedEventStreams}}, "dep:futures-core"{{/typedEventStreams}}{{{targetDeps}}}]
server = ["dep:axum", "dep:http"{{#serverStreams}}, "dep:futures-util"{{/serverStreams}}{{#serverRegex}}, "dep:regex"{{/serverRegex}}{{{targetDeps}}}]
{{/targetFeatures}}
{{#apiFeatures}}
{{#clientTarget}}
{{^serverTarget}}
# API features (apiFeatures): `<group>` compiles the group's API functions with its models and the HTTP client,
# `<group>-types` only its models. `types` is every model, `full` everything.
{{/serverTarget}}
{{#serverTarget}}
# API features (apiFeatures): `<group>` compiles the group's models with its API functions (with `client`) and its
# server operations (with `server`), `<group>-types` only its models. `types` is every model, `full` everything.
{{/serverTarget}}
{{/clientTarget}}
{{^clientTarget}}
{{#serverTarget}}
# API features (apiFeatures): `<group>` compiles the group's models and its server operations, `<group>-types` only
# its models. `types` is every model, `full` everything.
{{/serverTarget}}
{{^serverTarget}}
# API features (apiFeatures): `<group>` and `<group>-types` compile the group's models. `types` is every model,
# `full` everything.
{{/serverTarget}}
{{/clientTarget}}
full = [
{{#apiFeaturesFull}}
    "{{{.}}}",
{{/apiFeaturesFull}}
]
types = [
{{#apiFeaturesTypes}}
    "{{{.}}}",
{{/apiFeaturesTypes}}
]
_api = [{{{apiDeps}}}]
{{#apiFeatureGroups}}
# {{{selects}}}
{{{name}}} = ["{{{name}}}-types", "_api"]
{{{name}}}-types = [{{{typesDeps}}}]
{{/apiFeatureGroups}}
{{/apiFeatures}}
