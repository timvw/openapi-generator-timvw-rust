/// The parts of a `multipart/form-data` request, or `None` for a request without one.
#[allow(dead_code)]
async fn optional_multipart_parts(request: axum::extract::Request) -> Result<Option<Vec<FormPart>>, RequestError> {
    let multipart = request
        .headers()
        .get(http::header::CONTENT_TYPE)
        .and_then(|v| v.to_str().ok())
        .is_some_and(|v| v.trim_start().to_ascii_lowercase().starts_with("multipart/"));
