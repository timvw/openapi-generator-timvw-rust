[package]
name = "{{{packageName}}}"
version = "{{#lambdaVersion}}{{{packageVersion}}}{{/lambdaVersion}}"
{{#infoEmail}}
authors = ["{{{.}}}"]
{{/infoEmail}}
{{^infoEmail}}
authors = ["OpenAPI Generator team and contributors"]
{{/infoEmail}}
{{#appDescription}}
description = "{{{.}}}"
{{/appDescription}}
{{#licenseInfo}}
license = "{{.}}"
{{/licenseInfo}}
{{^licenseInfo}}
# Override this license by providing a License Object in the OpenAPI.
license = "Unlicense"
{{/licenseInfo}}
edition = "2021"
{{#publishRustRegistry}}
publish = ["{{.}}"]
{{/publishRustRegistry}}
{{#repositoryUrl}}
repository = "{{.}}"
{{/repositoryUrl}}
{{#documentationUrl}}
documentation = "{{.}}"
{{/documentationUrl}}
{{#homePageUrl}}
homepage = "{{.}}"
{{/homePageUrl}}

[dependencies]
{{#bonBuilders}}
bon = "^3"
{{/bonBuilders}}
serde = { version = "^1.0", features = ["derive"] }
{{#serdeWith}}
serde_with = { version = "^3.8", default-features = false, features = ["base64", "std", "macros"] }
{{/serdeWith}}
serde_json = "^1.0"
{{#typedEventStreams}}
futures-core = "^0.3"
{{/typedEventStreams}}
serde_repr = "^0.1"
{{#useSerdePathToError}}
serde_path_to_error = "^0.1"
{{/useSerdePathToError}}
url = "^2.5"
{{#validationRegex}}
regex = "^1.10"
{{/validationRegex}}
{{#hasUUIDs}}
uuid = { version = "^1.8", features = ["serde", "v4"] }
{{/hasUUIDs}}
{{#usesChronoTypes}}
chrono = { version = "^0.4",  features = ["serde"] }
{{/usesChronoTypes}}
{{#useAsyncFileStream}}
tokio = { version = "^1.46.0", features = ["fs"] }
tokio-util = { version = "^0.7", features = ["codec"] }
{{^httpStackTower}}
reqwest = { version = "^0.13", default-features = false, features = ["json", "multipart", "stream", "query", "form"] }
{{/httpStackTower}}
{{/useAsyncFileStream}}
{{#httpStackTower}}
timvw-rust-runtime = { version = "^{{{runtimeVersion}}}", default-features = false{{#runtimePath}}, path = "{{{.}}}"{{/runtimePath}} }

[features]
default = [{{#reqwestDefaultFeatures}}"{{.}}", {{/reqwestDefaultFeatures}}"retry"]
native-tls = ["timvw-rust-runtime/native-tls"]
rustls = ["timvw-rust-runtime/rustls"]
retry = ["timvw-rust-runtime/retry"]
tracing = ["timvw-rust-runtime/tracing"]
{{/httpStackTower}}
{{^httpStackTower}}
{{^useAsyncFileStream}}
reqwest = { version = "^0.13", default-features = false, features = ["json", "multipart"{{#typedEventStreams}}, "stream"{{/typedEventStreams}}, "query", "form"] }
{{/useAsyncFileStream}}
reqwest-middleware = { version = "^0.5", features = ["json", "multipart", "query", "form"] }

[features]
default = [{{#reqwestDefaultFeatures}}"{{.}}"{{^-last}}, {{/-last}}{{/reqwestDefaultFeatures}}]
native-tls = ["reqwest/native-tls"]
rustls = ["reqwest/rustls"]
{{/httpStackTower}}
