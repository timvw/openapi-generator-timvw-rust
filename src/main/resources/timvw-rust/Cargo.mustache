[package]
name = "{{{packageName}}}"
version = "{{#lambdaVersion}}{{{packageVersion}}}{{/lambdaVersion}}"
{{#infoEmail}}
authors = ["{{{.}}}"]
{{/infoEmail}}
{{^infoEmail}}
authors = ["OpenAPI Generator team and contributors"]
{{/infoEmail}}
{{#appDescription}}
description = "{{{.}}}"
{{/appDescription}}
{{#licenseInfo}}
license = "{{.}}"
{{/licenseInfo}}
{{^licenseInfo}}
# Override this license by providing a License Object in the OpenAPI.
license = "Unlicense"
{{/licenseInfo}}
edition = "2021"
{{#publishRustRegistry}}
publish = ["{{.}}"]
{{/publishRustRegistry}}
{{#repositoryUrl}}
repository = "{{.}}"
{{/repositoryUrl}}
{{#documentationUrl}}
documentation = "{{.}}"
{{/documentationUrl}}
{{#homePageUrl}}
homepage = "{{.}}"
{{/homePageUrl}}

[dependencies]
{{#bonBuilders}}
bon = "^3"
{{/bonBuilders}}
serde = { version = "^1.0", features = ["derive"] }
{{#serdeWith}}
serde_with = { version = "^3.8", default-features = false, features = ["base64", "std", "macros"] }
{{/serdeWith}}
serde_json = "^1.0"
{{#typedEventStreams}}
futures-core = "^0.3"
{{/typedEventStreams}}
serde_repr = "^0.1"
{{#useSerdePathToError}}
serde_path_to_error = "^0.1"
{{/useSerdePathToError}}
url = "^2.5"
{{#validationRegex}}
regex = "^1.10"
{{/validationRegex}}
{{#hasUUIDs}}
uuid = { version = "^1.8", features = ["serde", "v4"] }
{{/hasUUIDs}}
{{#usesChronoTypes}}
chrono = { version = "^0.4",  features = ["serde"] }
{{/usesChronoTypes}}
{{^httpStackTower}}
{{#useAsyncFileStream}}
tokio = { version = "^1.46.0", features = ["fs"]{{#apiFeatures}}, optional = true{{/apiFeatures}} }
tokio-util = { version = "^0.7", features = ["codec"]{{#apiFeatures}}, optional = true{{/apiFeatures}} }
reqwest = { version = "^0.13", default-features = false, features = ["json", "multipart", "stream", "query", "form"]{{#apiFeatures}}, optional = true{{/apiFeatures}} }
{{/useAsyncFileStream}}
{{/httpStackTower}}
{{#httpStackTower}}
timvw-rust-runtime = { version = "^{{{runtimeVersion}}}", default-features = false{{#runtimeFeatures}}, features = [{{{runtimeFeatures}}}]{{/runtimeFeatures}}{{#runtimePath}}, path = "{{{.}}}"{{/runtimePath}}{{#apiFeatures}}{{^runtimeRequired}}, optional = true{{/runtimeRequired}}{{/apiFeatures}} }
{{#hasUUIDs}}

# WebAssembly in a JavaScript host (wasm32-unknown-unknown): uuid's `v4` draws from `crypto.getRandomValues`.
[target.'cfg(all(target_family = "wasm", target_os = "unknown"))'.dependencies]
uuid = { version = "^1.8", features = ["js"] }
{{/hasUUIDs}}

[features]
default = [{{#reqwestDefaultFeatures}}"{{.}}", {{/reqwestDefaultFeatures}}"retry"{{#apiFeatures}}, "full"{{/apiFeatures}}]
native-tls = ["timvw-rust-runtime{{#apiFeatures}}{{^runtimeRequired}}?{{/runtimeRequired}}{{/apiFeatures}}/native-tls"]
rustls = ["timvw-rust-runtime{{#apiFeatures}}{{^runtimeRequired}}?{{/runtimeRequired}}{{/apiFeatures}}/rustls"]
retry = ["timvw-rust-runtime{{#apiFeatures}}{{^runtimeRequired}}?{{/runtimeRequired}}{{/apiFeatures}}/retry"]
tracing = ["timvw-rust-runtime{{#apiFeatures}}{{^runtimeRequired}}?{{/runtimeRequired}}{{/apiFeatures}}/tracing"]
{{/httpStackTower}}
{{^httpStackTower}}
{{^useAsyncFileStream}}
reqwest = { version = "^0.13", default-features = false, features = ["json", "multipart"{{#typedEventStreams}}, "stream"{{/typedEventStreams}}, "query", "form"]{{#apiFeatures}}, optional = true{{/apiFeatures}} }
{{/useAsyncFileStream}}
reqwest-middleware = { version = "^0.5", features = ["json", "multipart", "query", "form"]{{#apiFeatures}}, optional = true{{/apiFeatures}} }

[features]
default = [{{#reqwestDefaultFeatures}}"{{.}}"{{^-last}}, {{/-last}}{{/reqwestDefaultFeatures}}{{#apiFeatures}}, "full"{{/apiFeatures}}]
native-tls = ["reqwest{{#apiFeatures}}?{{/apiFeatures}}/native-tls"]
rustls = ["reqwest{{#apiFeatures}}?{{/apiFeatures}}/rustls"]
{{/httpStackTower}}
{{#apiFeatures}}
# API features (apiFeatures): `<group>` compiles the group's API functions with its models and the HTTP client,
# `<group>-types` only its models. `types` is every model, `full` everything.
full = [
{{#apiFeaturesFull}}
    "{{{.}}}",
{{/apiFeaturesFull}}
]
types = [
{{#apiFeaturesTypes}}
    "{{{.}}}",
{{/apiFeaturesTypes}}
]
_api = [{{#httpStackTower}}{{^runtimeRequired}}"dep:timvw-rust-runtime"{{/runtimeRequired}}{{/httpStackTower}}{{^httpStackTower}}"dep:reqwest", "dep:reqwest-middleware"{{#useAsyncFileStream}}, "dep:tokio", "dep:tokio-util"{{/useAsyncFileStream}}{{/httpStackTower}}]
{{#apiFeatureGroups}}
# {{{selects}}}
{{{name}}} = ["{{{name}}}-types", "_api"]
{{{name}}}-types = [{{#typesNeedRuntime}}"dep:timvw-rust-runtime"{{/typesNeedRuntime}}]
{{/apiFeatureGroups}}
{{/apiFeatures}}
