/// The first value of the header `name`, trimmed, read by `parse`: `None` when it is missing, not UTF-8 or does
/// not parse.
fn header_value<T>(headers: &http::HeaderMap, name: &str, parse: impl Fn(&str) -> Option<T>) -> Option<T> {
    let value = headers.get(name)?;
    parse(std::str::from_utf8(value.as_bytes()).ok()?.trim())
}

/// The items of the header `name`, a comma-separated list (the simple style), over every occurrence of the header,
/// each trimmed and read by `parse`; empty items are skipped. `None` when the header is missing, or when a value is
/// not UTF-8 or an item does not parse.
fn header_list<T>(headers: &http::HeaderMap, name: &str, parse: impl Fn(&str) -> Option<T>) -> Option<Vec<T>> {
    let mut values = headers.get_all(name).iter().peekable();
    values.peek()?;
    let mut items = Vec::new();
    for value in values {
        for item in std::str::from_utf8(value.as_bytes()).ok()?.split(',') {
            let item = item.trim();
            if !item.is_empty() {
                items.push(parse(item)?);
            }
        }
    }
    Some(items)
}

/// Appends the header `name` (a lower-case HTTP token) with `text`, unless `text` is not valid header text.
fn put(headers: &mut http::HeaderMap, name: &'static str, text: String) {
    if let Ok(value) = http::HeaderValue::from_str(&text) {
        headers.append(http::HeaderName::from_static(name), value);
    }
}

/// The text of a value that serializes to a JSON string or number (an enum): the string itself, or the number.
fn json_text<T: serde::Serialize>(value: &T) -> String {
    match serde_json::to_value(value) {
        Ok(serde_json::Value::String(s)) => s,
        Ok(other) => other.to_string(),
        Err(_) => String::new(),
    }
}
