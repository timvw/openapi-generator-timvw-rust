/// The first file part named `name`.
#[allow(dead_code)]
fn form_file(parts: &[FormPart], name: &str) -> Option<FilePart> {
    parts.iter().find(|p| p.name == name).map(FormPart::file)
}

/// The file parts named `name`; `None` when there is none.
#[allow(dead_code)]
fn form_files(parts: &[FormPart], name: &str) -> Option<Vec<FilePart>> {
    let files: Vec<FilePart> = parts.iter().filter(|p| p.name == name).map(FormPart::file).collect();
    (!files.is_empty()).then_some(files)
}

/// The text of the first part named `name`, read by `parse`; `None` when there is none.
#[allow(dead_code)]
fn form_value<T>(parts: &[FormPart], name: &str, parse: impl Fn(&str) -> Option<T>) -> Result<Option<T>, RequestError> {
    match parts.iter().find(|p| p.name == name) {
        None => Ok(None),
        Some(part) => {
            let v = part.text()?;
            parse(v).map(Some).ok_or_else(|| RequestError::new("body", Some(name), format!("invalid value '{v}'")))
        }
    }
}

/// The items of the parts named `name`, read by `parse`: one per part, the items of one part that holds a JSON
/// array (how a client without `multipartHelper` sends a list), or with a `separator` the items of each part split
/// by it (an urlencoded list the client joins); `None` when there is none.
#[allow(dead_code)]
fn form_list<T>(
    parts: &[FormPart],
    name: &str,
    separator: Option<&str>,
    parse: impl Fn(&str) -> Option<T>,
) -> Result<Option<Vec<T>>, RequestError> {
    let named: Vec<&FormPart> = parts.iter().filter(|p| p.name == name).collect();
    let mut texts = Vec::new();
    match named.as_slice() {
        [] => return Ok(None),
        _ if separator.is_some() => {
            let separator = separator.unwrap_or_default();
            for part in named {
                let text = part.text()?;
                if !text.is_empty() {
                    texts.extend(text.split(separator).map(str::to_owned));
                }
            }
        }
        [one] if one.bytes.starts_with(b"[") => {
            let items: Vec<serde_json::Value> =
                serde_json::from_slice(&one.bytes).map_err(|e| RequestError::new("body", Some(name), e.to_string()))?;
            for item in items {
                texts.push(match item {
                    serde_json::Value::String(text) => text,
                    other => other.to_string(),
                });
            }
        }
        _ => {
            for part in named {
                texts.push(part.text()?.to_owned());
            }
        }
    }
    let mut items = Vec::new();
    for v in texts {
        items.push(parse(&v).ok_or_else(|| RequestError::new("body", Some(name), format!("invalid item '{v}'")))?);
    }
    Ok(Some(items))
}

/// The JSON of the first part named `name`; `None` when there is none.
#[allow(dead_code)]
fn form_json<T: serde::de::DeserializeOwned>(parts: &[FormPart], name: &str) -> Result<Option<T>, RequestError> {
    match parts.iter().find(|p| p.name == name) {
        None => Ok(None),
        Some(part) => serde_json::from_slice(&part.bytes)
            .map(Some)
            .map_err(|e| RequestError::new("body", Some(name), e.to_string())),
    }
}

/// The items of the parts named `name`, each JSON: one per part, or the items of one part that holds a JSON array;
/// `None` when there is none.
#[allow(dead_code)]
fn form_json_list<T: serde::de::DeserializeOwned>(
    parts: &[FormPart],
    name: &str,
) -> Result<Option<Vec<T>>, RequestError> {
    let named: Vec<&FormPart> = parts.iter().filter(|p| p.name == name).collect();
    let invalid = |e: serde_json::Error| RequestError::new("body", Some(name), e.to_string());
    match named.as_slice() {
        [] => Ok(None),
        [one] if one.bytes.starts_with(b"[") => serde_json::from_slice(&one.bytes).map(Some).map_err(invalid),
        _ => named.iter().map(|part| serde_json::from_slice(&part.bytes).map_err(invalid)).collect::<Result<_, _>>().map(Some),
    }
}
