[package]
name = "{{{packageName}}}"
{{^splitCrates}}
version = "{{#lambdaVersion}}{{{packageVersion}}}{{/lambdaVersion}}"
{{/splitCrates}}
{{#splitCrates}}
version.workspace = true
{{/splitCrates}}
{{#infoEmail}}
authors = ["{{{.}}}"]
{{/infoEmail}}
{{^infoEmail}}
authors = ["OpenAPI Generator team and contributors"]
{{/infoEmail}}
{{#appDescription}}
description = "{{{.}}}"
{{/appDescription}}
{{#licenseInfo}}
license = "{{.}}"
{{/licenseInfo}}
{{^licenseInfo}}
# Override this license by providing a License Object in the OpenAPI.
license = "Unlicense"
{{/licenseInfo}}
edition = "2021"
# timvw-rust-runtime's minimum supported Rust version. To build on it, resolve dependency versions that support it:
# CARGO_RESOLVER_INCOMPATIBLE_RUST_VERSIONS=fallback cargo update (or resolver = "3" in your workspace).
rust-version = "{{{rustVersion}}}"
{{#publishRustRegistry}}
publish = ["{{.}}"]
{{/publishRustRegistry}}
{{#repositoryUrl}}
repository = "{{.}}"
{{/repositoryUrl}}
{{#documentationUrl}}
documentation = "{{.}}"
{{/documentationUrl}}
{{#homePageUrl}}
homepage = "{{.}}"
{{/homePageUrl}}

[dependencies]
{{^splitCrates}}
{{>cargo_dependencies}}
{{/splitCrates}}
{{#splitCrates}}
# The crates of the workspace (splitCrates): this crate re-exports them.
{{#splitFacadeDependencies}}
{{{.}}}
{{/splitFacadeDependencies}}
{{/splitCrates}}

[features]
{{#clientTarget}}
default = [{{#reqwestDefaultFeatures}}"{{.}}", {{/reqwestDefaultFeatures}}"retry"{{#apiFeatures}}, "full"{{/apiFeatures}}{{#targetFeatures}}, "client", "server"{{/targetFeatures}}]
native-tls = [{{^splitCrates}}"timvw-rust-runtime{{#runtimeOptional}}?{{/runtimeOptional}}/native-tls"{{/splitCrates}}{{#splitCrates}}"{{{splitCommonPackage}}}/native-tls"{{/splitCrates}}]
rustls = [{{^splitCrates}}"timvw-rust-runtime{{#runtimeOptional}}?{{/runtimeOptional}}/rustls"{{/splitCrates}}{{#splitCrates}}"{{{splitCommonPackage}}}/rustls"{{/splitCrates}}]
retry = [{{^splitCrates}}"timvw-rust-runtime{{#runtimeOptional}}?{{/runtimeOptional}}/retry"{{/splitCrates}}{{#splitCrates}}"{{{splitCommonPackage}}}/retry"{{/splitCrates}}]
tracing = [{{^splitCrates}}"timvw-rust-runtime{{#runtimeOptional}}?{{/runtimeOptional}}/tracing"{{/splitCrates}}{{#splitCrates}}"{{{splitCommonPackage}}}/tracing"{{/splitCrates}}]
{{/clientTarget}}
{{^clientTarget}}
default = [{{#apiFeatures}}"full"{{/apiFeatures}}]
{{/clientTarget}}
{{#targetFeatures}}
# Targets: `client` compiles the HTTP client (`apis`), `server` the axum server (`server`).
client = [{{#runtimeOptional}}"dep:timvw-rust-runtime", {{/runtimeOptional}}"dep:http"{{#typedEventStreams}}, "dep:futures-core"{{/typedEventStreams}}{{{targetDeps}}}]
server = ["dep:axum", "dep:http"{{#serverStreams}}, "dep:futures-util"{{/serverStreams}}{{#serverRegex}}, "dep:regex"{{/serverRegex}}{{#serverSendsWebhooks}}{{#runtimeOptional}}, "dep:timvw-rust-runtime"{{/runtimeOptional}}{{/serverSendsWebhooks}}{{{targetDeps}}}]
{{/targetFeatures}}
{{#apiFeatures}}
{{#clientTarget}}
{{^serverTarget}}
# API features (apiFeatures): `<group>` compiles the group's API functions with its models and the HTTP client,
# `<group>-types` only its models. `types` is every model, `full` everything.
{{/serverTarget}}
{{#serverTarget}}
# API features (apiFeatures): `<group>` compiles the group's models with its API functions (with `client`) and its
# server operations (with `server`), `<group>-types` only its models. `types` is every model, `full` everything.
{{/serverTarget}}
{{/clientTarget}}
{{^clientTarget}}
{{#serverTarget}}
# API features (apiFeatures): `<group>` compiles the group's models and its server operations, `<group>-types` only
# its models. `types` is every model, `full` everything.
{{/serverTarget}}
{{^serverTarget}}
# API features (apiFeatures): `<group>` and `<group>-types` compile the group's models. `types` is every model,
# `full` everything.
{{/serverTarget}}
{{/clientTarget}}
full = [
{{#apiFeaturesFull}}
    "{{{.}}}",
{{/apiFeaturesFull}}
]
types = [
{{#apiFeaturesTypes}}
    "{{{.}}}",
{{/apiFeaturesTypes}}
]
_api = [{{{apiDeps}}}]
{{#apiFeatureGroups}}
# {{{selects}}}
{{{name}}} = ["{{{name}}}-types", "_api"{{{apiFeatureDeps}}}]
{{{name}}}-types = [{{{typesDeps}}}]
{{/apiFeatureGroups}}
{{/apiFeatures}}
{{#splitCrates}}

{{>split_workspace}}
{{/splitCrates}}
